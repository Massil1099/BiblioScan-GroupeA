<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    android:padding="24dp"
    android:fillViewport="true"
    android:importantForAccessibility="yes">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="280dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:contentDescription="@null">

            <ImageView
                android:id="@+id/book_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Image de couverture du livre"
                android:background="@android:color/white" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titre du Livre"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/book_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Auteur"
            android:textSize="16sp"
            android:textColor="?attr/colorOnBackground"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/book_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description du livre..."
            android:textSize="15sp"
            android:textColor="?attr/colorOnBackground"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_edittext_background"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="2dp"
            android:importantForAccessibility="yes">

            <TextView android:id="@+id/book_publisher" style="@style/ResultTextView" android:contentDescription="Éditeur" />
            <TextView android:id="@+id/book_publishedDate" style="@style/ResultTextView" android:contentDescription="Date de publication" />
            <TextView android:id="@+id/book_pageCount" style="@style/ResultTextView" android:contentDescription="Nombre de pages" />
            <TextView android:id="@+id/book_categories" style="@style/ResultTextView" android:contentDescription="Catégories" />
            <TextView android:id="@+id/book_language" style="@style/ResultTextView" android:contentDescription="Langue" />
            <TextView android:id="@+id/book_isbn13" style="@style/ResultTextView" android:contentDescription="ISBN-13" />
            <TextView android:id="@+id/book_averageRating" style="@style/ResultTextView" android:contentDescription="Note moyenne" />
            <TextView android:id="@+id/book_ratingsCount" style="@style/ResultTextView" android:contentDescription="Nombre d'évaluations" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorites_button"
                style="@style/BiblioScan.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AJOUTER AUX FAVORIS"
                android:contentDescription="Ajouter ce livre aux favoris"
                app:icon="@drawable/ic_favorite"
                app:iconTint="@android:color/white"
                app:iconPadding="8dp"
                app:cornerRadius="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <View android:layout_width="16dp" android:layout_height="0dp" />

            <Button
                android:id="@+id/back_button"
                style="@style/BiblioScan.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RETOUR"
                android:contentDescription="Retour à l'écran précédent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
