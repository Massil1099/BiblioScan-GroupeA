<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:padding="16dp">

    <!-- Toolbar modernisée avec icône paramètres -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_accueil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="BIBLIOSCAN"
        app:titleTextColor="?attr/colorOnPrimary"
        app:titleMarginStart="16dp"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="Ouvrir les paramètres"
            android:layout_gravity="end"
            android:padding="8dp"
            android:focusable="true"
            app:tint="?attr/colorOnPrimary" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Menu principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_button"
            style="@style/BiblioScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Historique"
            android:contentDescription="Accéder à l'historique des détections"
            android:focusable="true"
            app:icon="@drawable/ic_history"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favorites_button"
            style="@style/BiblioScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Favoris"
            android:contentDescription="Voir les livres ajoutés en favoris"
            android:focusable="true"
            app:icon="@drawable/ic_favorite"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_button"
            style="@style/BiblioScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Authentification / Déconnexion"
            android:contentDescription="Gérer votre authentification"
            android:focusable="true"
            app:icon="@drawable/ic_auth"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/camera_button"
            style="@style/BiblioScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Commençons"
            android:contentDescription="Commencer une nouvelle détection de livres"
            android:focusable="true"
            app:icon="@drawable/ic_camera"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />
    </LinearLayout>
</LinearLayout>
