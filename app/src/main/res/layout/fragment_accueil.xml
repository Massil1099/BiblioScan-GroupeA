<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:padding="16dp">

    <!-- Toolbar modernisée avec icône paramètres -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_accueil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="BIBLIOSCAN"
        app:titleTextColor="?attr/colorOnPrimary"
        app:titleMarginStart="16dp"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="Ouvrir les paramètres"
            android:layout_gravity="end"
            android:padding="8dp"
            android:focusable="true"
            app:tint="?attr/colorOnPrimary" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Menu principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_button"
            style="@style/BiblioScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Historique"
            android:contentDescription="Accéder à l'historique des détections"
            android:focusable="true"
            app:icon="@drawable/ic_history"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favorites_button"
            style="@style/BiblioScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Favoris"
            android:contentDescription="Voir les livres ajoutés en favoris"
            android:focusable="true"
            app:icon="@drawable/ic_favorite"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_button"
            style="@style/BiblioScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Authentification / Déconnexion"
            android:contentDescription="Gérer votre authentification"
            android:focusable="true"
            app:icon="@drawable/ic_auth"
            app:iconTint="?attr/colorOnPrimary"
            app:iconGravity="textStart"
            app:iconPadding="2dp" />

        <!-- Bouton Commençons stylisé comme une CardView -->
        <androidx.cardview.widget.CardView
            android:id="@+id/camera_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/teal_700"
            app:cardUseCompatPadding="true"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_camera"
                    android:layout_marginEnd="16dp"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Commençons"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bouton Prendre une vidéo -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnPrendreVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/teal_700"
            app:cardUseCompatPadding="true"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prendre une vidéo"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
